Options -Indexes

RewriteEngine On

# Allow direct access to static files that exist on disk
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route all requests to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]
