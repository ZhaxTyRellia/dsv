Options -Indexes

RewriteEngine On

# Serve static assets directly from public/ directory
RewriteRule ^(css|img|js|videos)/(.*)$ public/$1/$2 [L]
RewriteRule ^app/(css|img|js|videos)/(.*)$ public/$1/$2 [L]

# Allow direct access to static files that exist on disk
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route all other requests to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]
