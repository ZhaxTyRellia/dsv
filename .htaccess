Options -Indexes
DirectoryIndex index.php public/index.php

RewriteEngine On

# Block direct HTTP access to sensitive directories and SQLite/config files
RewriteRule ^(storage|config|src|templates|vendor|\.git)(/|$) - [NC,F,L]
RewriteRule (^|/)\.(env|htaccess|git) - [NC,F,L]
RewriteRule \.(db|db-wal|db-shm|db-journal|sqlite|sqlite3|sql|bak|log)$ - [NC,F,L]

# Serve static assets directly from public/ directory
RewriteRule ^(css|img|js|videos)/(.*)$ public/$1/$2 [L]
RewriteRule ^app/(css|img|js|videos)/(.*)$ public/$1/$2 [L]

# Allow direct access to existing static files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route all virtual paths to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]
